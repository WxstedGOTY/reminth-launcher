{
  "name": "reminth-launcher",
  "version": "1.7.0",
  "description": "Reminth - a custom Minecraft launcher",
  "main": "src/main/main.js",
  "author": "Reminth",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1",
    "koffi": "^2.16.3"
  },
  "build": {
    "appId": "com.reminth.launcher",
    "productName": "Reminth",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "!assets/icons/reminth.icns",
      "!assets/icons/source/reminth-icon-master-1024.png",
      "!assets/icons/source/reminth-mark-1024.png",
      "!node_modules/koffi/build/koffi/{darwin,freebsd,linux,musl,openbsd}_*/**",
      "!node_modules/koffi/build/koffi/win32_{arm64,ia32}/**",
      "!node_modules/koffi/{src,vendor,doc}/**",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/reminth.ico"
    },
    "artifactName": "Reminth-Setup.exe",
    "protocols": [
      {
        "name": "Reminth",
        "schemes": [
          "reminth"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WxstedGOTY",
        "repo": "reminth-launcher"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reminth",
      "installerIcon": "assets/icons/reminth.ico",
      "uninstallerIcon": "assets/icons/reminth.ico",
      "installerHeaderIcon": "assets/icons/reminth.ico",
      "runAfterFinish": true
    }
  }
}
