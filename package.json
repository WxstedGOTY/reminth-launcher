{
  "name": "reminth-launcher",
  "version": "1.4.7",
  "description": "Reminth - a custom Minecraft launcher",
  "main": "src/main/main.js",
  "author": "Reminth",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "extract-zip": "^2.0.1"
  },
  "build": {
    "appId": "com.reminth.launcher",
    "productName": "Reminth",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "artifactName": "Reminth-Setup.exe",
    "protocols": [
      {
        "name": "Reminth",
        "schemes": [
          "reminth"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "WxstedGOTY",
        "repo": "reminth-launcher"
      }
    ],
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Reminth",
      "runAfterFinish": true
    }
  }
}
