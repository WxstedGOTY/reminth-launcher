{
	"schemaVersion": 1,
	"id": "reminthhud",
	"version": "${version}",
	"name": "Spaceport HUD",
	"description": "Part of Spaceport Launcher: Spaceport Built-in Mods (open with G, change the key in Controls) with Spaceport's own features - FPS, keystrokes, armor status, potion effects, zoom and more - and the top-right FPS/GPU/CPU bar.",
	"authors": [
		"Wxsted"
	],
	"contact": {},
	"license": "CC0-1.0",
	"icon": "assets/reminthhud/icon.png",
	"environment": "client",
	"entrypoints": {
		"main": [
			"com.wxsted.reminthhud.ReminthHud"
		],
		"client": [
			"com.wxsted.reminthhud.client.ReminthHudClient"
		]
	},
	"mixins": [
		{ "config": "reminthhud.mixins.json", "environment": "client" }
	],
	"custom": {
		"modmenu": { "badges": ["library"] }
	},
	"depends": {
		"fabricloader": "*",
		"minecraft": "${minecraft_range}",
		"java": ">=25",
		"fabric-api": "*"
	}
}